SITE_URL=https://your-domain.example
NEXT_PUBLIC_SITE_URL=https://your-domain.example
GOOGLE_SITE_VERIFICATION=
GA_MEASUREMENT_ID=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_DB_URL=
PORTFOLIO_SYNC_API_TOKEN=
# Used only by the local launchd activity sync script.
# SUPABASE_DB_URL must be a Postgres connection string with permission to call
# public.admin_replace_section().

# Visitor analytics (server only; secrets must be independently generated)
ANALYTICS_ENABLED=false
ANALYTICS_SIGNING_SECRET=
ANALYTICS_RATE_LIMIT_SECRET=
# Non-Vercel production only: APP_ENV=production
# Local QA only: ANALYTICS_QA_MODE=true
# Optional GA, only after disabling Enhanced Measurement history pageviews:
ANALYTICS_GA_MANUAL_PAGEVIEWS=false
# Local, isolated PostgreSQL integration tests only:
ANALYTICS_TEST_DB_URL=
