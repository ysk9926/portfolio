.pj .rl b{ color:var(--ink); font-weight:700; }
.pj .stack{ display:flex; flex-wrap:wrap; gap:4px; margin:0 0 10px; }
.pj .stack span{ font-family:var(--mono); font-size:7.6pt; color:var(--sub); border:1px solid var(--hair); background:#fff; padding:2px 8px; border-radius:100px; letter-spacing:0; }
.pj .grid{ display:grid; grid-template-columns:1fr 1fr; gap:8px 20px; }
.pj .blk{ break-inside:avoid; }
.pj .bt{ font-family:var(--mono); font-size:7.8pt; font-weight:600; letter-spacing:.1em; color:var(--faint); margin-bottom:3px; }
.pj .blk p{ font-size:9pt; color:var(--sub); line-height:1.74; }
.pj ul.dot>li{ font-size:9pt; margin-bottom:5px; }
.pj .imp{ margin-top:10px; display:grid; grid-template-columns:1fr 1fr; gap:10px; }
.pj .box{ border-radius:8px; padding:10px 13px; font-size:8.9pt; line-height:1.72; color:var(--sub); }
.pj .box .bt{ margin-bottom:2px; }
.pj .box.i{ background:var(--acc-bg); } .pj .box.i .bt{ color:var(--acc-dp); }
.pj .box.l{ background:var(--tint); } .pj .box.l .bt{ color:var(--gold); }

/* ---------- Brief list ---------- */
table.mx{ border-collapse:separate; border-spacing:0; width:100%; background:#fff; border:1px solid var(--hair); border-radius:8px; overflow:hidden; font-size:8.8pt; }
table.mx th{ background:var(--tint); font-weight:700; text-align:left; padding:8px 11px; border-bottom:1px solid var(--hair); font-size:8.6pt; }
table.mx td{ border-top:1px solid var(--hair); padding:8px 11px; vertical-align:top; color:var(--sub); line-height:1.7; }
table.mx td.pat{ background:var(--tint); font-weight:700; color:var(--ink); white-space:nowrap; }
table.mx td .co{ display:block; font-family:var(--mono); font-size:7.4pt; color:var(--faint); margin-top:2px; }
table.mx tr{ break-inside:avoid; }

/* ---------- Skills ---------- */
.sk{ display:grid; grid-template-columns:1fr 1fr; gap:6px 26px; }
.sk .r{ display:flex; gap:12px; padding:6px 0; border-bottom:1px dotted var(--hair); break-inside:avoid; }
.sk .c{ flex:0 0 90px; font-weight:700; font-size:8.8pt; }
.sk .l{ font-size:8.8pt; color:var(--sub); line-height:1.7; }

/* ---------- Footer ---------- */
.ft{ margin-top:14px; padding-top:8px; border-top:1px solid var(--hair); display:flex; justify-content:space-between; font-family:var(--mono); font-size:7.6pt; color:var(--faint); letter-spacing:.06em; }
.keep{ break-inside:avoid; }
.pb{ break-before:page; }
</style>
