.hd .contact .k{ font-family:var(--mono); font-size:7.8pt; color:var(--faint); letter-spacing:.06em; margin-right:6px; }

/* ---------- Section ---------- */
section{ margin-bottom:22px; }
.sec{ display:flex; align-items:baseline; gap:10px; border-bottom:1px solid var(--hair); padding-bottom:7px; margin-bottom:13px; }
