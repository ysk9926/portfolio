b{ font-weight:700; color:var(--ink); }
code{ font-family:var(--mono); font-size:.88em; background:var(--tint); border:1px solid var(--hair); padding:0 5px; border-radius:4px; color:var(--ink); }
a{ color:inherit; text-decoration:none; }

