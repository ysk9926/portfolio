/* paged.js 미로드 시(오프라인) 단일 시트 폴백 */
.page{ max-width:210mm; margin:24px auto; background:var(--bg); padding:16mm 15mm; box-shadow:0 10px 44px rgba(29,28,26,.14); }
@media print{ body{background:var(--bg)} .page{max-width:none;margin:0;padding:0;box-shadow:none} }
/* paged.js 로드 시: 화면에서도 A4 페이지 단위로 렌더 */
html{ background:#edebe6; }
.pagedjs_pages{ display:flex !important; flex-direction:column !important; flex-wrap:nowrap !important; align-items:center; gap:28px; width:auto !important; margin:0 !important; padding:28px 16px 48px; }
.pagedjs_page{ background:var(--bg); box-shadow:0 10px 44px rgba(29,28,26,.16); margin:0 auto 28px !important; }
.lead-keep{ break-inside:avoid; }
.pagedjs_page .page{ max-width:none; margin:0; padding:0; background:transparent; box-shadow:none; }
.pagedjs_margin-bottom-right{ font-family:var(--mono); font-size:7.6pt; color:var(--faint); letter-spacing:.06em; }
@media print{ html{background:var(--bg)} .pagedjs_pages{ display:block !important; padding:0; gap:0; } .pagedjs_page{ box-shadow:none; } }
